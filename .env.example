APP_ENV=lab                # lab = login local + simulador; production = integra com o ERP
APP_URL=https://talk.connect.lab
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=talk_dev
DB_USERNAME=talk
DB_PASSWORD=
TALK_KEY=                  # openssl rand -base64 32
TZ=America/Sao_Paulo
# pasta dos arquivos (imagens, áudios, PDFs); fora da pasta pública. Padrão: ./storage
TALK_STORAGE=
# SQL que acha a pessoa no ERP pelo telefone (ver src/Erp/SqlContactDirectory.php)
TALK_CONTACT_SQL=

# Fila: tempo de espera fica amarelo e vermelho a partir de (minutos)
QUEUE_WARN_MINUTES=15
QUEUE_LATE_MINUTES=30

# Jack (Jaqueline): triagem sem menu (ADR 0004). auto | off (off = tudo no setor padrão)
JACK_MODE=auto
JACK_WAIT_SECONDS=60
JACK_MAX_WAIT_SECONDS=600
# segundos de "digitando…" antes de cada mensagem dela (+1 s a cada 8 letras, até 90)
JACK_TYPING_SECONDS=20
