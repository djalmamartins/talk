#!/usr/bin/env php
<?php
// Worker de envio e da triagem da Jack. Uso: php bin/talk-worker  (rodar sob supervisor/Docker com restart)
declare(strict_types=1);

$app = require __DIR__ . '/../bootstrap.php';

$worker = $app['worker'];
$conversations = $app['conversations'];
$lastTriage = 0;
fwrite(STDOUT, "[talk-worker] iniciado\n");
while (true) {
    try {
        if (time() - $lastTriage >= 5) {      // triagem da Jack e agendamentos a cada 5 s
            $conversations->triage();
            $app['schedules']->runDue();
            $lastTriage = time();
        }
        $sent = $worker->runOnce() + $worker->fetchMedia();
        if ($sent === 0) {
            usleep(500_000);
        }
    } catch (\Throwable $e) {
        fwrite(STDERR, '[talk-worker] erro: ' . $e->getMessage() . "\n");
        sleep(2);
    }
}
