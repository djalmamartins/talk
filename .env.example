APP_ENV=lab                # lab = login local + simulador; production = integra com o ERP
APP_URL=https://talk.connect.lab
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=talk_dev
DB_USERNAME=talk
DB_PASSWORD=
TALK_KEY=                  # openssl rand -base64 32
TZ=America/Sao_Paulo
# pasta dos arquivos (imagens, áudios, PDFs); fora da pasta pública. Padrão: ./storage
TALK_STORAGE=
# SQL que acha a pessoa no ERP pelo telefone (ver src/Erp/SqlContactDirectory.php)
TALK_CONTACT_SQL=

# Fila: tempo de espera fica amarelo e vermelho a partir de (minutos)
QUEUE_WARN_MINUTES=15
QUEUE_LATE_MINUTES=30

# Jack (Jaqueline): auto | off. Na 1.4.0 (primeira de produção) ela fica DESLIGADA; volta numa versão seguinte.
JACK_MODE=off
# Com a Jack desligada: menu numerado dos setores no WhatsApp (1 Financeiro, 2 Administrativo, 3 Manutenção...).
# off = tudo vai direto para o setor padrão. Sem resposta ao menu por TALK_MENU_TIMEOUT_SECONDS: setor padrão.
TALK_MENU=on
TALK_MENU_TIMEOUT_SECONDS=600
JACK_WAIT_SECONDS=5
JACK_MAX_WAIT_SECONDS=30
# Setor Geral: toda conversa nova espera lá e a Jack distribui depois deste tempo (segundos)
JACK_GENERAL_SECONDS=60
# segundos de "digitando…" antes de cada mensagem dela (+1 s a cada 8 letras, até 90)
JACK_TYPING_SECONDS=20
# Jack conta ao cliente o número e o link do chamado quando encaminha (off = encaminha calada)
JACK_TICKET_NOTICE=on
# Só uma pessoa online pode atender o setor: a conversa vai direto para ela (off = sempre espera na fila)
AUTO_ASSIGN=on
# Chamado no SAC só pelo botão Abrir chamado, com o mesmo protocolo da conversa (padrão). on = toda conversa encaminhada
# abre chamado sozinha, como antes da 1.0.
SAC_AUTO_TICKET=off

# Avaliação pós-atendimento: ao encerrar, pergunta a nota de 1 a 5. on | off
TALK_RATING=on

# Seletor de sistemas (alto do menu): endereço do Connect ERP, ex.: https://erp.connect.com.br
# Vazio = o ERP aparece apagado no seletor. Quem pode entrar é o ERP que decide, no login dele.
ERP_WEB_URL=
# Login (ADR 0006): com ERP_API_URL e ERP_WEB_URL, só se entra pelo Connect ERP (mesmo e-mail, senha e 2FA), e só
# quem tem no ERP a permissão "Atendimento por WhatsApp (Connect Talk)". O token precisa do escopo staff.login,
# e o .env do ERP precisa de TALK_URL com o endereço deste Talk. senha = volta às senhas do próprio Talk (laboratório).
TALK_LOGIN=erp
# a cada quantos segundos o Talk confere no ERP se a pessoa ainda tem acesso
TALK_LOGIN_RECHECK_SECONDS=600

# WhatsApp por QR Code: servidor da Evolution API (um só para todos os números).
# No cadastro do número a tela pede só nome e número. Vazio no laboratório = QR Code simulado.
EVOLUTION_URL=
EVOLUTION_API_KEY=

# IA local da Jack (docs/jack/IA.md). No Mac: tools/local/jack-ia-lab.sh (Ollama + Gemma 3 1B).
# off | shadow (só registra o que faria) | on (decide quando tem certeza; regras de reserva)
JACK_AI=off
JACK_AI_URL=http://host.docker.internal:11434
JACK_AI_MODEL=gemma3:1b
JACK_AI_TIMEOUT=10
