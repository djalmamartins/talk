# Connect Talk — produção. Copie para deploy/.env e preencha. NUNCA coloque este arquivo no Git.
# endereço do Talk, ex.: talk.connectcondominios.com.br, e o mesmo com https:// (o instalar-pi.sh pergunta)
APP_URL=
TALK_DOMAIN=
TZ=America/Sao_Paulo

# Entrada pela internet (ADR 0005): tunnel = Cloudflare Tunnel, sem abrir porta (padrão no Raspberry Pi);
# caddy = HTTPS próprio com as portas 80/443 abertas no roteador para este aparelho.
COMPOSE_PROFILES=tunnel
# token do túnel (Cloudflare Zero Trust > Networks > Tunnels), começa com eyJ; só com COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# banco (o docker-compose cria com estes dados na primeira vez)
DB_DATABASE=talk
DB_USERNAME=talk
DB_PASSWORD=                # senha forte: openssl rand -base64 24
DB_ROOT_PASSWORD=           # outra senha forte (usada só pelo backup)
# memória do banco: 256M no Raspberry Pi de 4 GB; num PC com folga, 1G
DB_BUFFER_POOL=256M

# chave que cifra os tokens do WhatsApp guardados no banco: openssl rand -base64 32
# GUARDE UMA CÓPIA FORA DO PC (gerenciador de senhas). Sem ela o backup do banco não recupera os tokens.
TALK_KEY=

# integração com o ERP (API REST, docs/api-erp.md); vazio = Talk funciona sozinho.
# ERP_API_URL termina em /api/v1. O token (ctk_...) é gerado no servidor do ERP com
# php tools/talk-token.php criar --usuario=EMAIL_DO_USUARIO_DE_INTEGRACAO e aparece uma vez só.
ERP_API_URL=
ERP_API_TOKEN=

# Seletor de sistemas (alto do menu): endereço do Connect ERP, ex.: https://erp.connect.com.br
# Vazio = o ERP aparece apagado no seletor. Quem pode entrar é o ERP que decide, no login dele.
ERP_WEB_URL=
# Login (ADR 0006): com ERP_API_URL e ERP_WEB_URL, só se entra pelo Connect ERP (mesmo e-mail, senha e 2FA), e só
# quem tem no ERP a permissão "Atendimento por WhatsApp (Connect Talk)". O token precisa do escopo staff.login,
# e o .env do ERP precisa de TALK_URL com o endereço deste Talk. senha = volta às senhas do próprio Talk (laboratório).
TALK_LOGIN=erp
# a cada quantos segundos o Talk confere no ERP se a pessoa ainda tem acesso
TALK_LOGIN_RECHECK_SECONDS=600

# WhatsApp por QR Code: chave interna entre o Talk e o motor do WhatsApp (serviço "whatsapp").
# Gere com: openssl rand -hex 24. O endereço já vem pronto no docker-compose.
# Depois disso, cadastrar um número na tela pede só o nome e o número, e o QR Code aparece.
EVOLUTION_API_KEY=

# Jack (Jaqueline): auto | off. Na 1.4.0 (primeira de produção) ela fica DESLIGADA; volta numa versão seguinte.
JACK_MODE=off
# Com a Jack desligada, onde a conversa nova cai (TALK_ENTRY): geral = fila do setor Geral, que todos veem, e cada um
# pega a sua (padrão da 1.5.0) | menu = menu numerado de setores no WhatsApp | padrao = direto no setor padrão.
TALK_ENTRY=geral
# só com TALK_ENTRY=menu: sem resposta ao menu por este tempo, vai para o setor padrão
TALK_MENU_TIMEOUT_SECONDS=600
JACK_WAIT_SECONDS=5
JACK_MAX_WAIT_SECONDS=30
# Setor Geral: toda conversa nova espera lá e a Jack distribui depois deste tempo (segundos)
JACK_GENERAL_SECONDS=60
JACK_TYPING_SECONDS=20
# Jack conta ao cliente o número e o link do chamado quando encaminha (off = encaminha calada)
JACK_TICKET_NOTICE=on
# Distribuição automática (on = se só uma pessoa do setor está online, a conversa vai direto para ela).
# 1.5.0: off, cada um pega na fila.
AUTO_ASSIGN=off
# Chamado no SAC só pelo botão Abrir chamado, com o mesmo protocolo da conversa (padrão). on = toda conversa encaminhada
# abre chamado sozinha, como antes da 1.0.
SAC_AUTO_TICKET=off

# IA local da Jack (docs/jack/IA.md): off | shadow (só registra o que faria) | on (decide quando tem certeza)
# Para usar: COMPOSE_PROFILES=tunnel,ia, o modelo em deploy/ia/modelo.gguf e JACK_AI=shadow.
JACK_AI=off
JACK_AI_URL=http://jack-ia:8080
JACK_AI_MODEL=gemma3:1b
# segundos que a Jack espera a IA antes de seguir com as regras
JACK_AI_TIMEOUT=4
JACK_AI_THREADS=4

QUEUE_WARN_MINUTES=15
QUEUE_LATE_MINUTES=30
TALK_RATING=on

# backup diário: hora (0–23) e quantos dias guardar
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
# pasta das cópias no aparelho. No Pi, prefira um pendrive ou HD externo (ex.: /media/backup/talk), para não
# perder o backup junto com o disco do sistema.
BACKUP_DIR=./backups
