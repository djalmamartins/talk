RewriteEngine On
# app do celular: passa o cabeçalho Authorization (Bearer) para o PHP em qualquer modo do Apache
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]

# arquivos das conversas: até 16 MB (limite do WhatsApp para mídia)
<IfModule mod_php.c>
  php_value upload_max_filesize 17M
  php_value post_max_size 18M
</IfModule>
