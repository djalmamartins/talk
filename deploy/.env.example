# Connect Talk — produção. Copie para deploy/.env e preencha. NUNCA coloque este arquivo no Git.
APP_URL=https://talk.connect.com.br
TALK_DOMAIN=talk.connect.com.br
TZ=America/Sao_Paulo

# banco (o docker-compose cria com estes dados na primeira vez)
DB_DATABASE=talk
DB_USERNAME=talk
DB_PASSWORD=                # senha forte: openssl rand -base64 24
DB_ROOT_PASSWORD=           # outra senha forte (usada só pelo backup)

# chave que cifra os tokens do WhatsApp guardados no banco: openssl rand -base64 32
# GUARDE UMA CÓPIA FORA DO PC (gerenciador de senhas). Sem ela o backup do banco não recupera os tokens.
TALK_KEY=

# integração com o ERP (API REST, docs/api-erp.md); vazio = Talk funciona sozinho
ERP_API_URL=
ERP_API_TOKEN=

# Seletor de sistemas (alto do menu): endereço do Connect ERP, ex.: https://erp.connect.com.br
# Vazio = o ERP aparece apagado no seletor. Quem pode entrar é o ERP que decide, no login dele.
ERP_WEB_URL=

# WhatsApp por QR Code: chave interna entre o Talk e o motor do WhatsApp (serviço "whatsapp").
# Gere com: openssl rand -hex 24. O endereço já vem pronto no docker-compose.
# Depois disso, cadastrar um número na tela pede só o nome e o número, e o QR Code aparece.
EVOLUTION_API_KEY=

# Jack (Jaqueline): auto | off
JACK_MODE=auto
JACK_WAIT_SECONDS=5
JACK_MAX_WAIT_SECONDS=30
# Setor Geral: toda conversa nova espera lá e a Jack distribui depois deste tempo (segundos)
JACK_GENERAL_SECONDS=60
JACK_TYPING_SECONDS=20

QUEUE_WARN_MINUTES=15
QUEUE_LATE_MINUTES=30
TALK_RATING=on

# backup diário: hora (0–23) e quantos dias guardar
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
